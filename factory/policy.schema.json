{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "TEVM coding factory policy",
	"type": "object",
	"additionalProperties": false,
	"required": ["schemaVersion", "repository", "toolchain", "issues", "approvals", "gates"],
	"$defs": {
		"corpusPin": {
			"type": "object",
			"additionalProperties": false,
			"required": ["url", "sha256", "extractPath"],
			"properties": {
				"url": {
					"type": "string",
					"format": "uri"
				},
				"sha256": {
					"type": "string",
					"pattern": "^[0-9a-f]{64}$"
				},
				"extractPath": {
					"type": "string",
					"minLength": 1
				}
			}
		}
	},
	"properties": {
		"$schema": {
			"type": "string"
		},
		"schemaVersion": {
			"const": 1
		},
		"repository": {
			"type": "object",
			"additionalProperties": false,
			"required": ["owner", "name", "defaultBranch"],
			"properties": {
				"owner": {
					"type": "string",
					"minLength": 1
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"defaultBranch": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"cloud": {
			"type": "object",
			"additionalProperties": false,
			"required": ["origin", "repoUrl", "mcpUrl", "objectStore", "docsUrl", "docsIndexUrl", "publicTodos", "publicFactory", "githubMirror"],
			"properties": {
				"origin": { "type": "string", "format": "uri" },
				"repoUrl": { "type": "string", "format": "uri" },
				"mcpUrl": { "type": "string", "format": "uri" },
				"objectStore": { "type": "string", "format": "uri" },
				"docsUrl": { "type": "string", "format": "uri" },
				"docsIndexUrl": { "type": "string", "format": "uri" },
				"publicTodos": { "type": "boolean" },
				"publicFactory": { "type": "boolean" },
				"githubMirror": { "type": "string", "enum": ["pull", "push", "two-way"] }
			}
		},
		"cache": {
			"type": "object",
			"additionalProperties": false,
			"required": ["provider", "endpoint", "readSecret", "writeSecret"],
			"properties": {
				"provider": { "type": "string", "minLength": 1 },
				"endpoint": { "type": "string", "format": "uri" },
				"readSecret": { "type": "string", "minLength": 1 },
				"writeSecret": { "type": "string", "minLength": 1 }
			}
		},
		"trust": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"maintainers",
				"acceptExecutionFrom",
				"allowUntrustedExecution",
				"untrustedCacheRead",
				"untrustedCacheWrite",
				"untrustedSkipGates",
				"oneTimeAuthRequiredForSandboxes",
				"protectedPaths"
			],
			"properties": {
				"maintainers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
				"acceptExecutionFrom": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
				"allowUntrustedExecution": { "type": "boolean" },
				"untrustedCacheRead": { "type": "boolean" },
				"untrustedCacheWrite": { "const": false },
				"untrustedSkipGates": { "const": false },
				"oneTimeAuthRequiredForSandboxes": { "type": "boolean" },
				"protectedPaths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
			}
		},
		"toolchain": {
			"type": "object",
			"additionalProperties": false,
			"required": ["node", "pnpm", "codexCli", "models", "flows", "zevm"],
			"properties": {
				"node": {
					"type": "string",
					"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
				},
				"pnpm": {
					"type": "string",
					"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
				},
				"codexCli": {
					"type": "string",
					"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
				},
				"models": {
					"type": "object",
					"additionalProperties": false,
					"required": ["implementation", "review"],
					"properties": {
						"implementation": {
							"type": "string",
							"minLength": 1
						},
						"review": {
							"type": "string",
							"minLength": 1
						}
					}
				},
				"flows": {
					"type": "object",
					"additionalProperties": false,
					"required": ["localPath", "repository", "revision"],
					"properties": {
						"localPath": {
							"type": "string",
							"minLength": 1
						},
						"repository": {
							"type": "string",
							"format": "uri"
						},
						"revision": {
							"type": "string",
							"pattern": "^[0-9a-f]{40}$"
						}
					}
				},
				"zevm": {
					"type": "object",
					"additionalProperties": false,
					"required": ["localPath", "repository"],
					"properties": {
						"localPath": {
							"type": "string",
							"minLength": 1
						},
						"repository": {
							"type": "string",
							"format": "uri"
						}
					}
				}
			}
		},
		"issues": {
			"type": "object",
			"additionalProperties": false,
			"required": ["approvalLabel", "pauseLabels", "types", "requiredHeadings", "routes"],
			"properties": {
				"approvalLabel": {
					"type": "string",
					"minLength": 1
				},
				"pauseLabels": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"uniqueItems": true
				},
				"types": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"minItems": 1,
					"uniqueItems": true
				},
				"requiredHeadings": {
					"type": "object",
					"additionalProperties": {
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1
						},
						"uniqueItems": true
					},
					"required": ["all"]
				},
				"routes": {
					"type": "object",
					"additionalProperties": {
						"type": "string",
						"minLength": 1
					}
				}
			}
		},
		"approvals": {
			"type": "object",
			"additionalProperties": {
				"type": "string",
				"minLength": 1
			},
			"required": ["intake", "candidateDiff", "pullRequest", "fork", "release", "deploy"]
		},
		"gates": {
			"type": "object",
			"additionalProperties": {
				"type": "array",
				"items": {
					"type": "string",
					"pattern": "^//"
				},
				"uniqueItems": true
			},
			"required": ["intake", "candidate", "pullRequest"]
		},
		"corpus": {
			"type": "object",
			"additionalProperties": false,
			"required": ["ethereumTests", "executionSpecTests"],
			"properties": {
				"ethereumTests": {
					"$ref": "#/$defs/corpusPin"
				},
				"executionSpecTests": {
					"$ref": "#/$defs/corpusPin"
				}
			}
		}
	}
}
