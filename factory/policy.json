{
	"$schema": "./policy.schema.json",
	"schemaVersion": 1,
	"repository": {
		"owner": "evmts",
		"name": "tevm",
		"defaultBranch": "main"
	},
	"toolchain": {
		"node": "24.12.0",
		"pnpm": "10.33.4",
		"codexCli": "0.150.1",
		"models": {
			"implementation": "gpt-5.6-sol",
			"review": "gpt-5.6-luna"
		},
		"flows": {
			"localPath": "vendor/flows",
			"repository": "https://github.com/smithersai/flows-proto.git",
			"revision": "9a0b718b891faf0f95c807934a7687d284602afc"
		},
		"zevm": {
			"localPath": "vendor/zevm",
			"repository": "https://github.com/evmts/zevm.git",
			"revision": "014f3f2b8dba45a983853af303bc52620fcfb111"
		}
	},
	"issues": {
		"approvalLabel": "factory:ready",
		"pauseLabels": ["factory:hold", "needs:maintainer", "security"],
		"types": ["bug", "feature", "docs", "conformance", "maintenance"],
		"requiredHeadings": {
			"all": ["Summary", "Acceptance criteria"],
			"bug": ["Reproduction", "Expected behavior"],
			"feature": ["Motivation"],
			"docs": ["Documentation location"],
			"conformance": ["Fixture or test ID", "Reference result"],
			"maintenance": ["Why now"]
		},
		"routes": {
			"bug": "issue-to-pr",
			"feature": "issue-to-plan",
			"docs": "issue-to-pr",
			"conformance": "conformance-triage",
			"maintenance": "issue-to-plan"
		}
	},
	"approvals": {
		"intake": "none-read-only",
		"candidateDiff": "explicit-smthrs-invocation-or-factory-ready-label",
		"pullRequest": "factory-ready-label-and-factory-approval-environment",
		"fork": "explicit-contributor-action",
		"release": "manual-smithers-approval",
		"deploy": "manual-smithers-approval"
	},
	"gates": {
		"intake": ["//factory:issueIntakeTest", "//factory:policyLint"],
		"candidate": ["//:mechanicalPrePush", "//:agentLints"],
		"planCandidate": ["//factory:queueLint"],
		"pullRequest": ["//factory:check", "//:mechanicalPrePush"],
		"planPullRequest": ["//factory:check", "//factory:queueLint"]
	},
	"corpus": {
		"ethereumTests": {
			"url": "https://raw.githubusercontent.com/ethereum/tests/v17.2/fixtures_general_state_tests.tgz",
			"sha256": "82bc3cb1c23f48b2b8a2b3d9cb5d9b96ddf6c31683f75368173bee3b25a24274",
			"extractPath": "GeneralStateTests"
		},
		"executionSpecTests": {
			"url": "https://github.com/ethereum/execution-spec-tests/releases/download/v5.4.0/fixtures_stable.tar.gz",
			"sha256": "92cf1b47ad12fb27163261fc3c1cea5df72439cab507983d06b56c94f8741909",
			"extractPath": "fixtures/state_tests"
		}
	}
}
