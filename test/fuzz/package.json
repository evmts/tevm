{
	"name": "@tevm/fuzz",
	"version": "0.0.0",
	"private": true,
	"description": "Comprehensive multi-engine fuzz testing suite for TEVM (fast-check, @smthrs/fuzz, Jazzer.js, Rust, and Zig)",
	"repository": {
		"type": "git",
		"url": "https://github.com/evmts/tevm.git",
		"directory": "test/fuzz"
	},
	"license": "MIT",
	"type": "module",
	"scripts": {
		"fuzz:all": "node ../../scripts/fuzz/run-fuzz-campaign.mjs",
		"fuzz:effect": "TEVM_FUZZ_MODE=campaign vitest run src/effect-feedback.fuzz.spec.ts",
		"fuzz:fast": "vitest run",
		"fuzz:intensive": "TEVM_FUZZ_RUNS=500 TEVM_FUZZ_EFFECT_EXECUTIONS=5000 vitest run",
		"fuzz:jazzer": "node ./scripts/run-jazzer.mjs",
		"lint": "biome check . --write --unsafe",
		"lint:check": "biome check .",
		"test": "vitest run",
		"test:run": "vitest run",
		"test:watch": "vitest --watch",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@jazzer.js/core": "^4.0.0",
		"@smthrs/fuzz": "1.0.0-rc.18",
		"@tevm/actions": "workspace:*",
		"@tevm/bundler-cache": "workspace:*",
		"@tevm/common": "workspace:*",
		"@tevm/config": "workspace:*",
		"@tevm/contract": "workspace:*",
		"@tevm/effect": "workspace:*",
		"@tevm/errors": "workspace:*",
		"@tevm/ethers": "workspace:*",
		"@tevm/http-client": "workspace:*",
		"@tevm/jsonrpc": "workspace:*",
		"@tevm/logger": "workspace:*",
		"@tevm/mcp": "workspace:*",
		"@tevm/memory-client": "workspace:*",
		"@tevm/node": "workspace:*",
		"@tevm/predeploys": "workspace:*",
		"@tevm/resolutions": "workspace:*",
		"@tevm/runtime": "workspace:*",
		"@tevm/server": "workspace:*",
		"@tevm/tsconfig": "workspace:*",
		"@tevm/utils": "workspace:*",
		"@tevm/viem": "workspace:*",
		"@tevm/whatsabi": "workspace:*",
		"@types/node": "^24.12.4",
		"effect": "4.1.1",
		"ethers": "^6.13.4",
		"fast-check": "^4.11.0",
		"tevm": "workspace:*",
		"typescript": "^6.0.3",
		"viem": "^2.58.4",
		"vitest": "^4.1.6",
		"ws": "^8.20.1"
	}
}
