{
	"name": "@tevm/lsp",
	"version": "1.0.0-rc.153",
	"private": false,
	"description": "The language server for Tevm",
	"keywords": [
		"typescript",
		"plugin",
		"solidity",
		"sol",
		"tevm"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/evmts/tevm.git",
		"directory": "lsp/lsp"
	},
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"tevm-lsp": "./bin/tevm-lsp.cjs"
	},
	"files": [
		"bin/**/*.cjs",
		"dist/**/*.js",
		"dist/**/*.d.ts"
	],
	"scripts": {
		"build:dist": "tsc --skipLibCheck",
		"build:types": "tsc --skipLibCheck --emitDeclarationOnly",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@tevm/base-bundler": "workspace:^",
		"@tevm/bundler-cache": "workspace:^",
		"@tevm/config": "workspace:^",
		"@volar/language-core": "~2.4.28",
		"@volar/language-server": "~2.4.28",
		"@volar/language-service": "~2.4.28",
		"effect": "3.21.2",
		"solc": "0.8.35",
		"typescript": "^6.0.3",
		"volar-service-css": "0.0.71",
		"volar-service-emmet": "0.0.71",
		"volar-service-html": "0.0.71",
		"volar-service-typescript": "^0.0.71",
		"vscode-html-languageservice": "^5.6.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@tevm/tsconfig": "workspace:^",
		"@tevm/tsupconfig": "workspace:^",
		"tsup": "^8.5.1",
		"typedoc": "^0.28.19",
		"typedoc-plugin-markdown": "^4.11.0",
		"vitest": "^4.1.6"
	},
	"publishConfig": {
		"access": "public"
	}
}
