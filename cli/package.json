{
	"name": "@tevm/cli",
	"version": "1.0.0-rc.155",
	"description": "Command-line interface for native Tevm nodes, sessions, and JSON-RPC servers",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/evmts/tevm.git",
		"directory": "cli"
	},
	"license": "MIT",
	"sideEffects": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/cli.d.ts",
			"default": "./dist/cli.js"
		},
		"./package.json": "./package.json"
	},
	"main": "dist/cli.js",
	"module": "dist/cli.js",
	"types": "dist/cli.d.ts",
	"bin": "dist/cli.js",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "pnpm run build:app",
		"build:app": "tsc --skipLibCheck",
		"dev": "tsx src/cli.tsx",
		"format": "biome format . --write",
		"lint": "biome check . --write --unsafe",
		"lint:check": "biome check . --verbose",
		"lint:deps": "bunx depcheck --ignores=@tevm/contract",
		"test": "prettier --check . && xo && ava",
		"test:coverage": "pnpm run build:app && vitest run --coverage",
		"test:run": "vitest run"
	},
	"xo": {
		"extends": "xo-react",
		"prettier": true,
		"rules": {
			"react/prop-types": "off"
		}
	},
	"prettier": "@vdemedes/prettier-config",
	"ava": {
		"extensions": {
			"ts": "module",
			"tsx": "module"
		},
		"nodeArguments": [
			"--import=tsx"
		]
	},
	"dependencies": {
		"@tanstack/react-query": "^5.108.4",
		"@tevm/actions": "workspace:^",
		"@tevm/base-bundler": "^1.0.0-rc.151",
		"@tevm/bundler-cache": "^1.0.0-rc.151",
		"@tevm/common": "workspace:^",
		"@tevm/config": "^1.0.0-rc.151",
		"@tevm/contract": "workspace:^",
		"@tevm/memory-client": "workspace:^",
		"@tevm/server": "workspace:^",
		"@tevm/utils": "workspace:^",
		"@types/glob": "^9.0.0",
		"@types/json-bigint": "^1.0.4",
		"effect": "3.22.5",
		"figures": "^6.1.0",
		"glob": "^13.0.7",
		"ink": "^7.1.1",
		"ink-big-text": "^2.0.0",
		"ink-gradient": "^4.0.1",
		"ink-select-input": "^6.2.0",
		"ink-spinner": "^5.0.0",
		"ink-text-input": "^6.0.0",
		"json-bigint": "^1.0.0",
		"pastel": "^4.0.1",
		"react": "^19.3.1",
		"solc": "^0.8.39",
		"viem": "^2.58.6",
		"zod": "^4.6.7",
		"zustand": "^5.1.0"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^8.1.0",
		"@types/ink-big-text": "^1.2.4",
		"@types/ink-gradient": "^2.0.4",
		"@types/react": "^19.3.3",
		"@vdemedes/prettier-config": "^2.0.1",
		"ava": "^8.4.0",
		"chalk": "^5.6.2",
		"ink-testing-library": "^4.0.0",
		"prettier": "^3.10.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"xo": "^2.0.2"
	},
	"engines": {
		"node": ">=16"
	},
	"publishConfig": {
		"access": "public"
	}
}
